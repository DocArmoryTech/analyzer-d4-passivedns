[
    {
      "type": "matrix",
      "name": "matrix_alert",
      "homeserver_url": "https://matrix.org",
      "access_token": "syt_abc123...",
      "room_id": "!roomid:matrix.org",
      "template": "matrix_template.jinja",
      "filter": {
        "type": "string",
        "condition": {"rrtype": "A"}
      }
    },
    {
      "type": "mail",
      "name": "mail_alert",
      "smtp_host": "smtp.example.com",
      "smtp_port": 587,
      "sender": "alerts@example.com",
      "recipient": "admin@example.com",
      "filter": {
        "type": "dnsbl",
        "dnsbl_domain": "zen.spamhaus.org"
      }
    },
    {
      "type": "log",
      "name": "log_alert",
      "level": "info",
      "filter": {
        "type": "string",
        "condition": {"rrtype": "A"}
      }
    },
    {
      "type": "mattermost",
      "name": "mattermost_alert",
      "webhook_url": "https://mattermost.example.com/hooks/xyz123",
      "filter": {
        "type": "string",
        "condition": {"rrtype": "A", "rdata": "regex:192\\.168\\..*"}
      }
    },
    {
      "type": "rocket",
      "name": "rocketchat_alert",
      "webhook_url": "https://rocketchat.example.com/hooks/abc456",
      "filter": {
        "type": "string",
        "condition": {"rrname": "example.com"}
      }
    }
  ]